{
  "name": "SynCO (Node + MySQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/Synco",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "SynCO", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm start"
}
